# ============ 后端环境变量（复制为 server/.env 后填值） ============
# 服务端口（Render 会自动注入 PORT，本地默认 4000）
PORT=4000

# 前端来源白名单（CORS）：仅放行你的 Netlify 公网域名
CORS_ORIGIN=https://yezhe.netlify.app

# JWT 签名密钥（生产请改成随机长字符串）
JWT_SECRET=change_me_to_a_long_random_secret

# ============ 数据库 ============
# 留空 = 使用本地 SQLite 文件（server/data/app.db）做开发/冒烟
# 填 Neon 连接串 = 切换到 Postgres 生产库（代码无需改动）
# 例：postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ============ 微信小程序登录 ============
# 留空 = 开发期返回 DEBUG_<code> 兜底（不影响联调）
WX_APPID=
WX_SECRET=

# ============ 图片存储 ============
# 支持两种 S3 兼容后端：腾讯云 COS（优先）、Cloudflare R2（兜底）。代码全环境变量驱动，无需改代码。
# 优先级：填齐 COS_* → 用 COS；未填 COS 但填齐 R2_* → 用 R2；都未填 → 报错（绝不写本地磁盘）。

# ---- 腾讯云 COS（推荐，国内 CDN，大陆直连无需代理）----
# COS_SECRET_ID / COS_SECRET_KEY：访问密钥（API 密钥管理，子账号密钥）
# COS_BUCKET：桶名称，如 yezhe-studio-1250000000
# COS_REGION：地域简称，如 ap-guangzhou
# COS_CDN_DOMAIN：图片对外访问域名（桶默认域名 https://<bucket>.cos.<region>.myqcloud.com 或自定义 CDN 加速域名）
# COS_STORAGE_LIMIT：可选，存储告警阈值（字节），如 10GB = 10737418240；不填则不限
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_CDN_DOMAIN=
COS_STORAGE_LIMIT=

# ---- Cloudflare R2（兜底后端）----
# 填齐下列 5 项 = 启用 R2（仅在未配置 COS 时生效）
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_WORKER_DOMAIN=   # Worker 只读代理域名，如 https://yezhe-img-proxy.yezhe128627.workers.dev
PUBLIC_UPLOAD_BASE=/uploads
