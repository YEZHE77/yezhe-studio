# ============ 后端环境变量（复制为 server/.env 后填值） ============
# 服务端口（Render 会自动注入 PORT，本地默认 4000）
PORT=4000

# 前端来源白名单（CORS）：仅放行你的 Netlify 公网域名
CORS_ORIGIN=https://yezhe.netlify.app

# JWT 签名密钥（生产请改成随机长字符串）
JWT_SECRET=change_me_to_a_long_random_secret

# ============ 数据库 ============
# 留空 = 使用本地 SQLite 文件（server/data/app.db）做开发/冒烟
# 填 Neon 连接串 = 切换到 Postgres 生产库（代码无需改动）
# 例：postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ============ 微信小程序登录 ============
# 留空 = 开发期返回 DEBUG_<code> 兜底（不影响联调）
WX_APPID=
WX_SECRET=

# ============ 图片存储 ============
# 留空 = 图片存到本地 server/data/uploads，前端用 /uploads/xxx 访问（兜底）
# 填齐下列 4 项 = 自动切换 Cloudflare R2（代码无需改动）
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=        # R2 公开访问域名，如 https://<bucket>.r2.cloudflarestorage.com
PUBLIC_UPLOAD_BASE=/uploads
