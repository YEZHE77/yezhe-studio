.page { padding: 0 0 40rpx; }
.order { margin: 0 32rpx 20rpx; padding: 28rpx; background: #fff; border-radius: 16rpx; }
.order-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.order-pkg { font-size: 30rpx; font-weight: 600; }
.order-status { font-size: 24rpx; color: #fff; background: #111; padding: 6rpx 18rpx; border-radius: 20rpx; }
.order-amt { display: flex; gap: 32rpx; margin-top: 10rpx; }

.d-pkg { font-size: 36rpx; font-weight: 700; }
.d-status { display: inline-block; margin: 12rpx 0 20rpx; font-size: 24rpx; color: #fff; background: #111; padding: 6rpx 20rpx; border-radius: 20rpx; }
.d-amt { display: flex; gap: 48rpx; margin-bottom: 24rpx; }
.d-block { margin-bottom: 24rpx; }
.d-label { font-size: 26rpx; font-weight: 600; margin-bottom: 10rpx; }
.d-actions { display: flex; flex-direction: column; gap: 18rpx; }
.d-evaluated { text-align: center; margin-top: 16rpx; }
.noop {}
