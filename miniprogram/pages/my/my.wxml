<view class="page">
  <customNav title="我的" />

  <!-- 个人资料头 -->
  <view class="profile">
    <view class="avatar">{{nickname ? nickname[0] : '叶'}}</view>
    <view class="profile-info">
      <view class="profile-name">{{nickname || '叶哲 STUDIO 用户'}}</view>
      <view class="muted small">{{login ? '已登录' : '未登录'}}</view>
    </view>
  </view>

  <!-- 主菜单：我的预约 / 我的相册 / 消息通知 / 个人资料修改 -->
  <view class="menu card">
    <view class="menu-item" bindtap="go" data-url="/pkg/appointment/appointment">
      <text>我的预约</text><text class="muted">›</text>
    </view>
    <view class="menu-item" bindtap="openMyAlbum">
      <text>我的相册</text><text class="muted">›</text>
    </view>
    <view class="menu-item" bindtap="go" data-url="/pkg/subscribe/subscribe">
      <text>消息通知</text><text class="muted">›</text>
    </view>
    <view class="menu-item" bindtap="openProfile">
      <text>个人资料修改</text><text class="muted">›</text>
    </view>
  </view>

  <!-- 次要：联系 / 后台 / 关于 -->
  <view class="menu card">
    <view class="menu-item" bindtap="copyContact">
      <text>联系摄影师（复制微信号）</text><text class="muted">{{studio.contact.wechat || 'yezhe-studio'}} ›</text>
    </view>
    <view class="menu-item" bindtap="openAdmin">
      <text>商家管理后台</text><text class="muted">›</text>
    </view>
    <view class="menu-item" bindtap="go" data-url="/pkg/about/about">
      <text>关于{{studio.name || '叶哲 STUDIO'}}</text><text class="muted">›</text>
    </view>
  </view>

  <!-- 个人资料修改弹窗 -->
  <view wx:if="{{showProfile}}" class="mask" bindtap="closeProfile">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">个人资料修改</view>
      <view class="field-label">昵称</view>
      <input class="field" value="{{nickname}}" bindinput="onNick" placeholder="请输入昵称" />
      <view class="field-label">微信号</view>
      <input class="field" value="{{wechat}}" bindinput="onWx" placeholder="用于摄影师联系您" />
      <button class="sheet-btn" bindtap="saveProfile">保存</button>
    </view>
  </view>
</view>
