page { background: #f3f1ec; }
.page { padding: 24rpx 24rpx 60rpx; }

.profile {
  display: flex; align-items: center; padding: 48rpx 40rpx;
  background: #111111; color: #fff; border-radius: 24rpx; margin-bottom: 28rpx;
}
.avatar {
  width: 110rpx; height: 110rpx; border-radius: 50%; background: #fff; color: #111;
  display: flex; align-items: center; justify-content: center; font-size: 48rpx; font-weight: 700;
}
.profile-info { margin-left: 28rpx; }
.profile-name { font-size: 36rpx; font-weight: 600; letter-spacing: 2rpx; }
.profile-info .muted { color: rgba(255,255,255,.6); margin-top: 6rpx; }

.card {
  background: #faf8f3; border-radius: 24rpx; margin-bottom: 28rpx;
  box-shadow: 0 4rpx 18rpx rgba(0,0,0,0.04); overflow: hidden;
}
.card:last-of-type { margin-bottom: 0; }
.menu-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 34rpx 30rpx; font-size: 30rpx; color: #2c2c2c;
}
.menu-item + .menu-item { border-top: 1rpx solid #efece4; }
.muted { color: #bbb; }

/* 个人资料修改弹窗 */
.mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.45);
  display: flex; align-items: flex-end; z-index: 100;
}
.sheet {
  width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0;
  padding: 40rpx 40rpx 60rpx; box-sizing: border-box;
}
.sheet-title { font-size: 34rpx; font-weight: 600; text-align: center; margin-bottom: 36rpx; color: #2c2c2c; }
.field-label { font-size: 26rpx; color: #888; margin: 22rpx 0 12rpx; }
.field {
  width: 100%; height: 84rpx; padding: 0 24rpx; box-sizing: border-box;
  background: #f5f5f3; border-radius: 12rpx; font-size: 28rpx; color: #2c2c2c;
}
.sheet-btn {
  margin-top: 44rpx; height: 86rpx; line-height: 86rpx; border-radius: 12rpx;
  background: #7ecdbb; color: #fff; font-size: 30rpx; text-align: center;
}
.sheet-btn::after { border: none; }
