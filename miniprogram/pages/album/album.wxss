.page { padding: 24rpx 20rpx 40rpx; }
.head { padding: 12rpx 20rpx 20rpx; display: flex; flex-direction: column; gap: 6rpx; }
.head-t { font-size: 36rpx; font-weight: 700; }

.grid { display: flex; flex-wrap: wrap; }
.cell { position: relative; width: calc(50% - 12rpx); margin: 6rpx; border-radius: 10rpx; overflow: hidden; }
.cell-img { width: 100%; height: 380rpx; display: block; background: #eee; }
.cell-zone { position: absolute; left: 12rpx; top: 12rpx; background: rgba(0,0,0,.6); color: #fff; font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 16rpx; }
.cell-save { position: absolute; right: 12rpx; bottom: 12rpx; background: #111; color: #fff; font-size: 22rpx; padding: 8rpx 22rpx; border-radius: 24rpx; }
