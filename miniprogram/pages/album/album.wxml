<view class="page">
  <view class="head">
    <text class="head-t">成片相册</text>
    <text class="muted small" wx:if="{{allowDownload}}">长按或点「保存」存到相册</text>
    <text class="muted small" wx:else>仅可浏览，保存未开放</text>
  </view>

  <view class="grid" wx:if="{{photos.length}}">
    <view class="cell" wx:for="{{photos}}" wx:key="id">
      <image class="cell-img" src="{{item.photo_url}}" mode="aspectFill" bindtap="preview" data-url="{{item.photo_url}}" />
      <view class="cell-zone" wx:if="{{item.zone === 'final'}}">精修</view>
      <view class="cell-save" wx:if="{{allowDownload}}" catchtap="save" data-url="{{item.photo_url}}">保存</view>
    </view>
  </view>
  <view wx:else class="empty">还没有成片</view>
</view>
