<view class="page">
  <!-- 顶部轮播 Banner -->
  <swiper class="banner" indicator-dots autoplay circular interval="4000" duration="500" wx:if="{{banners.length}}">
    <swiper-item wx:for="{{banners}}" wx:key="*this">
      <image class="banner-img" src="{{item}}" mode="aspectFill" lazy-load />
    </swiper-item>
  </swiper>
  <view wx:else class="banner banner--ph">
    <view class="banner-logo">YEZHE STUDIO</view>
    <view class="banner-tag">海口婚礼 / 人像摄影</view>
  </view>

  <!-- 关于我们 -->
  <view class="about">
    <view class="about-en">About Us</view>
    <view class="about-title">{{studio.name || '叶哲 STUDIO'}}</view>
    <view class="about-logo" wx:if="{{studio.logo}}">
      <image src="{{studio.logo}}" mode="aspectFill" />
    </view>
    <view class="about-slogan">{{studio.intro || '拍摄有温度的照片，记录平凡生活中的美好。'}}</view>
    <view class="about-actions">
      <button class="btn btn-primary" open-type="contact">联系我们</button>
      <button class="btn btn-outline" bindtap="copyWechat">+ 关注</button>
    </view>
    <view class="about-more" bindtap="goAbout">查看品牌故事 ›</view>
  </view>

  <!-- 作品展示 Gallery -->
  <view class="gallery">
    <view class="gallery-en">GALLERY</view>
    <view class="gallery-title">作品展示</view>

    <!-- 分类标签 -->
    <scroll-view class="cat-bar" scroll-x scroll-with-animation>
      <view class="cat-wrap">
        <view class="cat-item {{activeCat === 0 ? 'active' : ''}}" bindtap="selectCat" data-id="0">全部</view>
        <view wx:for="{{categories}}" wx:key="id" class="cat-item {{activeCat === item.id ? 'active' : ''}}" bindtap="selectCat" data-id="{{item.id}}">{{item.name}}</view>
      </view>
    </scroll-view>

    <!-- 作品网格 -->
    <view class="grid" wx:if="{{works.length}}">
      <view class="grid-item" wx:for="{{works}}" wx:key="id" bindtap="openWork" data-id="{{item.id}}">
        <image class="grid-cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
        <view wx:if="{{item.live}}" class="live-badge">图片直播</view>
        <view class="grid-cap">
          <text class="grid-title">{{item.customer_name || item.title}}</text>
          <text class="grid-tag">#{{item.category_name || '作品'}}</text>
        </view>
      </view>
    </view>

    <view wx:elif="{{!loading}}" class="empty">暂无作品</view>

    <!-- 加载更多 -->
    <view wx:if="{{works.length && hasMore}}" class="more-btn" bindtap="loadMore">MORE</view>
    <view wx:if="{{works.length && !hasMore}}" class="more-end">— 没有更多了 —</view>
  </view>

  <!-- 底部联系信息 -->
  <view class="footer">
    <view class="footer-title">联系我们</view>
    <view class="footer-line" wx:if="{{studio.contact.wechat}}">
      <text class="footer-label">微信</text>
      <text class="footer-value">{{studio.contact.wechat}}</text>
      <text class="footer-action" bindtap="copyWechat">复制</text>
    </view>
    <view class="footer-line" wx:if="{{studio.contact.phone}}">
      <text class="footer-label">电话</text>
      <text class="footer-value">{{studio.contact.phone}}</text>
      <text class="footer-action" bindtap="callPhone">拨打</text>
    </view>
    <view class="footer-line" wx:if="{{studio.contact.address}}">
      <text class="footer-label">地址</text>
      <text class="footer-value">{{studio.contact.address}}</text>
    </view>
    <view class="footer-copy">叶哲 STUDIO · 用影像记录时光</view>
  </view>

</view>
