page { background: #f9f8f6; }
.page { padding-bottom: 60rpx; }

/* ===== 轮播 Banner（4:3 比例，750rpx 宽对应 562rpx 高，按 aspect-ratio 自适应） ===== */
.banner { width: 100%; aspect-ratio: 4 / 3; }
.banner-img { width: 100%; height: 100%; }
.banner--ph {
  background: #111; color: #fff;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  aspect-ratio: 4 / 3;
}
.banner-logo { font-size: 40rpx; letter-spacing: 10rpx; opacity: .9; }
.banner-tag { margin-top: 20rpx; font-size: 26rpx; opacity: .6; letter-spacing: 4rpx; }

/* ===== 品牌简介（扁平流式，间距全部用 margin，禁止容器 padding 制造空白） ===== */
.brand {
  text-align: center;
  /* 仅保留横向内边距用于内容缩进；垂直间距一律用 margin（见下）
     轮播底部 → 圆形头像顶部：50rpx */
  padding: 0 32rpx;
  margin-top: 50rpx;
  background: transparent;
}
.brand-logo {
  width: 120rpx; height: 120rpx; margin: 0 auto;
  border-radius: 50%; overflow: hidden;
  background: #eee; border: 1rpx solid #e5e5e5;
}
.brand-logo image { width: 100%; height: 100%; }
/* 头像底部 → 工作室名称：32rpx */
.brand-name {
  margin-top: 32rpx; font-size: 40rpx; font-weight: 600;
  color: #2c2c2c; letter-spacing: 4rpx;
}
.brand-address {
  margin-top: 12rpx; font-size: 24rpx; color: #999;
  display: flex; align-items: center; justify-content: center;
  line-height: 1.4;
}
.addr-icon { margin-right: 6rpx; font-size: 22rpx; }
.brand-slogan {
  margin-top: 12rpx; font-size: 24rpx;
  line-height: 1.5; color: #888;
}
.brand-actions {
  margin-top: 24rpx; display: flex; justify-content: center; gap: 20rpx;
}
.brand-actions .btn {
  min-width: 200rpx; height: 68rpx; line-height: 68rpx;
  font-size: 26rpx; border-radius: 8rpx; text-align: center;
  padding: 0 28rpx; margin: 0;
}
.btn::after { border: none; }
.btn-primary {
  background: #7ecdbb; color: #fff;
}
.btn-outline {
  background: #fff; color: #7ecdbb; border: 2rpx solid #7ecdbb;
}
/* 工作室名称 → 查看品牌故事：下移 20rpx（16→36rpx）；查看品牌故事底部 → 资料区块结束：64rpx */
.brand-more {
  margin-top: 36rpx; margin-bottom: 64rpx; text-align: center;
  font-size: 24rpx; color: #7ecdbb;
}

/* 资料区块结束后的浅灰色分割线（高度 8rpx，通栏） */
.divider {
  width: 100%;
  height: 8rpx;
  background: #eee;
}

/* 分割线底部 → 作品展示标题顶部：100rpx */
.gallery { margin-top: 100rpx; padding: 0 32rpx; }
.gallery-title {
  text-align: center; font-size: 40rpx; font-weight: 600; color: #2c2c2c; letter-spacing: 4rpx;
}
.gallery-sub {
  text-align: center; margin-top: 6rpx; font-size: 22rpx; letter-spacing: 2rpx; color: #bbb;
}

/* 分类标签 */
.cat-bar { margin-top: 16rpx; white-space: nowrap; }
.cat-wrap { display: inline-flex; gap: 24rpx; padding: 4rpx 4rpx 20rpx; }
.cat-item {
  display: inline-block; font-size: 26rpx; color: #888; padding: 10rpx 6rpx;
  position: relative; transition: color .2s;
}
.cat-item.active { color: #2c2c2c; font-weight: 600; }
.cat-item.active::after {
  content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 4rpx;
  background: #7ecdbb; border-radius: 4rpx;
}

/* 作品网格 */
.grid { display: flex; flex-wrap: wrap; margin: 8rpx -10rpx 0; }
.grid-item {
  width: calc(50% - 20rpx); margin: 10rpx; position: relative; border-radius: 16rpx;
  overflow: hidden; background: #eee;
}
.grid-cover { width: 100%; aspect-ratio: 4 / 5; height: auto; display: block; }
.grid-cap {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 60rpx 18rpx 18rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.55), transparent);
}
.grid-title {
  display: block; color: #fff; font-size: 26rpx; font-weight: 500;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.grid-tag {
  display: block; margin-top: 6rpx; color: rgba(255,255,255,0.85); font-size: 22rpx;
}
.live-badge {
  position: absolute; top: 16rpx; right: 16rpx;
  background: rgba(126,205,187,0.95); color: #fff;
  font-size: 20rpx; padding: 6rpx 14rpx; border-radius: 6rpx;
}

/* MORE / 空态 */
.more-btn {
  margin: 44rpx auto 0; width: 260rpx; height: 76rpx; line-height: 76rpx;
  text-align: center; border: 2rpx solid #ccc; color: #666; font-size: 26rpx;
  border-radius: 8rpx;
}
.more-end {
  margin-top: 44rpx; text-align: center; color: #bbb; font-size: 24rpx;
}
.empty { padding: 80rpx 0; text-align: center; color: #999; font-size: 26rpx; }

/* ===== 底部联系 ===== */
.footer {
  margin: 70rpx 32rpx 0; padding: 48rpx 40rpx 36rpx;
  background: #2c2c2c; border-radius: 24rpx; color: #fff;
}
.footer-title {
  text-align: center; font-size: 32rpx; font-weight: 600; letter-spacing: 4rpx; margin-bottom: 30rpx;
}
.footer-line {
  display: flex; align-items: center; margin-bottom: 18rpx; font-size: 26rpx;
}
.footer-label { width: 80rpx; color: #aaa; }
.footer-value { flex: 1; color: #fff; }
.footer-action {
  margin-left: 16rpx; color: #7ecdbb; font-size: 24rpx;
}
.footer-copy {
  margin-top: 30rpx; text-align: center; font-size: 22rpx; color: #777;
}

/* ===== 右侧悬浮按钮组（160rpx 圆形，图标在上文字在下） ===== */
.fab-group {
  position: fixed;
  right: 40rpx;
  top: 120rpx;
  z-index: 90;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}
.fab {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 22rpx rgba(0,0,0,0.16);
}
.fab::after { border: none; }
.fab-white { background: #fff; }
.fab-primary { background: #48c8c0; }
.fab-ico {
  width: 56rpx;
  height: 56rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
/* 空心爱心（灰 #666666） */
.fab-ico-heart {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23666666' stroke-width='1.6' stroke-linejoin='round'><path d='M12 20.3l-1.45-1.32C5.4 14.24 2 11.16 2 7.5 2 4.42 4.42 2 7.5 2c1.74 0 3.41.81 4.5 2.09C13.09 2.81 14.76 2 16.5 2 19.58 2 22 4.42 22 7.5c0 3.66-3.4 6.74-8.55 11.49L12 20.3z'/></svg>");
}
/* 对话气泡带三点（白） */
.fab-ico-chat {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23ffffff' stroke-width='1.6' stroke-linejoin='round'><path d='M4 5h16a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H10l-4 3v-3H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z'/><circle cx='9' cy='11' r='1' fill='%23ffffff' stroke='none'/><circle cx='12' cy='11' r='1' fill='%23ffffff' stroke='none'/><circle cx='15' cy='11' r='1' fill='%23ffffff' stroke='none'/></svg>");
}
/* 用户人形轮廓（灰 #666666） */
.fab-ico-user {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23666666' stroke-width='1.6' stroke-linecap='round'><circle cx='12' cy='8' r='3.2'/><path d='M5 20a7 7 0 0 1 14 0'/></svg>");
}
.fab-label {
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1;
}
.fab-white .fab-label { color: #666666; }
.fab-primary .fab-label { color: #ffffff; }
/* 点击轻微缩放反馈 */
.fab-hover { transform: scale(0.95); }
