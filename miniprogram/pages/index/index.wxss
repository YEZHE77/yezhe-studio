page { background: #f3f1ec; }

/* 独立卡片容器：浅米白底，与页面暖浅灰底轻微区分，区块间呼吸留白 */
.page { padding: 24rpx 24rpx 80rpx; }
.card {
  background: #faf8f3;
  border-radius: 24rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 18rpx rgba(0,0,0,0.04);
  overflow: hidden;
}
.card:last-of-type { margin-bottom: 0; }

/* ===== ① 轮播 Banner ===== */
.banner-card { padding: 0; }
.banner { width: 100%; height: 320rpx; }
.banner-img { width: 100%; height: 100%; }
.banner--ph {
  background: #111; color: #fff;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  height: 320rpx;
}
.banner-logo { font-size: 44rpx; letter-spacing: 10rpx; opacity: .9; }
.banner-tag { margin-top: 20rpx; font-size: 26rpx; opacity: .6; letter-spacing: 4rpx; }

/* ===== ② 品牌介绍 ===== */
.brand-card { text-align: center; padding: 48rpx 36rpx 40rpx; }
.brand-logo {
  width: 128rpx; height: 128rpx; margin: 0 auto;
  border-radius: 50%; overflow: hidden;
  background: #eee; border: 1rpx solid #e5e5e5;
}
.brand-logo image { width: 100%; height: 100%; }
.brand-name {
  margin-top: 22rpx; font-size: 42rpx; font-weight: 600;
  color: #2c2c2c; letter-spacing: 4rpx;
}
.brand-actions {
  margin-top: 30rpx; display: flex; justify-content: center; gap: 24rpx;
}
.brand-actions .btn {
  flex: 1; max-width: 260rpx; height: 76rpx; line-height: 76rpx;
  font-size: 28rpx; border-radius: 10rpx; text-align: center;
  padding: 0 28rpx; margin: 0;
}
.btn::after { border: none; }
.btn-primary { background: #7ecdbb; color: #fff; }
.btn-outline { background: #fff; color: #7ecdbb; border: 2rpx solid #7ecdbb; }
.brand-address {
  margin-top: 28rpx; font-size: 24rpx; color: #999;
  display: flex; align-items: center; justify-content: center; line-height: 1.4;
}
.addr-icon { margin-right: 6rpx; font-size: 22rpx; }
.brand-slogan {
  margin-top: 12rpx; font-size: 25rpx; line-height: 1.6; color: #888;
  padding: 0 20rpx;
}
.brand-more {
  margin-top: 22rpx; text-align: center; font-size: 25rpx; color: #7ecdbb;
}

/* ===== ③ 作品展示 ===== */
/* 仅在「品牌模块底部 → 作品展示顶部」之间加大外边距，露出页面底色形成视觉断开；其余卡片间距保持 .card 的 28rpx 不变 */
.gallery-card { margin-top: 96rpx; padding: 44rpx 28rpx 40rpx; }
.gallery-en {
  text-align: center; font-size: 22rpx; letter-spacing: 6rpx; color: #999;
  text-transform: uppercase;
}
.gallery-title {
  text-align: center; margin-top: 8rpx; font-size: 42rpx; font-weight: 600; color: #2c2c2c; letter-spacing: 4rpx;
}

/* 分类标签 */
.cat-bar { margin-top: 22rpx; white-space: nowrap; }
.cat-wrap { display: inline-flex; gap: 28rpx; padding: 4rpx 4rpx 22rpx; }
.cat-item {
  display: inline-block; font-size: 27rpx; color: #999; padding: 10rpx 6rpx;
  position: relative; transition: color .2s;
}
.cat-item.active { color: #2c2c2c; font-weight: 600; }
.cat-item.active::after {
  content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 4rpx;
  background: #7ecdbb; border-radius: 4rpx;
}

/* 作品网格 */
.grid { display: flex; flex-wrap: wrap; margin: 8rpx -10rpx 0; }
.grid-item {
  width: calc(50% - 20rpx); margin: 10rpx; position: relative; border-radius: 18rpx;
  overflow: hidden; background: #eee;
}
.grid-cover { width: 100%; aspect-ratio: 4 / 5; height: auto; display: block; }
.grid-cap {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 60rpx 18rpx 18rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.55), transparent);
}
.grid-title {
  display: block; color: #fff; font-size: 26rpx; font-weight: 500;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.grid-tag {
  display: block; margin-top: 6rpx; color: rgba(255,255,255,0.85); font-size: 22rpx;
}
.live-badge {
  position: absolute; top: 16rpx; right: 16rpx;
  background: rgba(126,205,187,0.95); color: #fff;
  font-size: 20rpx; padding: 6rpx 14rpx; border-radius: 6rpx;
}

/* MORE / 空态 */
.more-btn {
  margin: 44rpx auto 0; width: 260rpx; height: 76rpx; line-height: 76rpx;
  text-align: center; border: 2rpx solid #ccc; color: #666; font-size: 26rpx;
  border-radius: 8rpx;
}
.more-end {
  margin-top: 44rpx; text-align: center; color: #bbb; font-size: 24rpx;
}
.empty { padding: 80rpx 0; text-align: center; color: #999; font-size: 26rpx; }

/* ===== 底部联系 ===== */
.footer-card { padding: 44rpx 40rpx 36rpx; }
.footer-title {
  text-align: center; font-size: 32rpx; font-weight: 600; letter-spacing: 4rpx; margin-bottom: 30rpx; color: #2c2c2c;
}
.footer-line {
  display: flex; align-items: center; margin-bottom: 18rpx; font-size: 26rpx; color: #555;
}
.footer-label { width: 80rpx; color: #999; }
.footer-value { flex: 1; color: #333; }
.footer-action { margin-left: 16rpx; color: #7ecdbb; font-size: 24rpx; }
.footer-copy { margin-top: 30rpx; text-align: center; font-size: 22rpx; color: #aaa; }

/* ===== 右侧悬浮按钮组（固定，悬浮于卡片上层） ===== */
.fab-group {
  position: fixed;
  right: 24rpx;
  bottom: 50%;
  transform: translateY(50%);
  z-index: 90;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.fab {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 22rpx rgba(0,0,0,0.16);
}
.fab::after { border: none; }
.fab-white { background: #fff; color: #2c2c2c; }
.fab-primary { background: #7ecdbb; color: #fff; }
.fab-icon { font-size: 30rpx; line-height: 1; margin-bottom: 4rpx; }
.fab-text { font-size: 20rpx; font-weight: 500; line-height: 1; }
