page { background: #ffffff; }
.page { padding-bottom: 60rpx; }

/* ===== 自定义顶部标题栏（白底黑字「叶哲 STUDIO」居中，固定置顶，避让系统状态栏） ===== */
.topbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: #ffffff;
  box-sizing: border-box;
}
.topbar-title {
  height: 44px;
  line-height: 44px;
  text-align: center;
  color: #111111;
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  /* 给右侧原生胶囊按钮预留空间，避免标题文字被覆盖 */
  padding: 0 180rpx;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ===== 轮播 Banner（页面已用动态 navHeight 整体下偏移，避让状态栏与原生胶囊；高度固定屏幕 32%） ===== */
.swiper-wrap { width: 100%; }
/* 高度占屏幕 32%（32vh），不撑满大半屏，一眼可见下方作品区；
   图片 aspectFit 完整显示，不裁切人物头部/主体画面。
   页面 padding-top: navHeight 已为顶部胶囊预留安全内边距，人脸不会被子系统 UI 遮挡。 */
.banner { width: 100%; height: 32vh; background: transparent; }
.banner-img { width: 100%; height: 100%; object-fit: contain; display: block; }
.banner--ph {
  background: #111; color: #fff;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  height: 32vh;
}
.banner-logo { font-size: 40rpx; letter-spacing: 10rpx; opacity: .9; }
.banner-tag { margin-top: 20rpx; font-size: 26rpx; opacity: .6; letter-spacing: 4rpx; }

/* ===== 品牌简介（扁平流式，间距全部用 margin，禁止容器 padding 制造空白） ===== */
.brand {
  text-align: center;
  /* 收紧整块垂直留白：轮播底部 → 圆形头像顶部 36rpx */
  padding: 0 32rpx;
  margin-top: 36rpx;
  background: transparent;
}
.brand-logo {
  width: 96rpx; height: 96rpx; margin: 0 auto;
  border-radius: 50%; overflow: hidden;
  background: #eee; border: 1rpx solid #e5e5e5;
}
.brand-logo image { width: 100%; height: 100%; }
/* 头像底部 → 工作室名称：20rpx（收紧 logo 上下空白） */
.brand-name {
  margin-top: 20rpx; font-size: 40rpx; font-weight: 600; line-height: 1.2;
  color: #2c2c2c; letter-spacing: 4rpx;
}
.brand-address {
  margin-top: 12rpx; font-size: 24rpx; color: #999;
  display: flex; align-items: center; justify-content: center;
  line-height: 1.4;
}
.addr-icon { margin-right: 6rpx; font-size: 22rpx; }
.brand-slogan {
  margin-top: 12rpx; font-size: 24rpx;
  line-height: 1.5; color: #888;
}
.brand-actions {
  /* 主转化按钮占 62%、描边按钮占 34%，中间留少量间距；整体限制宽度避免大屏过宽 */
  margin: 28rpx auto 0; display: flex; align-items: stretch; gap: 24rpx;
  max-width: 600rpx;
}
.brand-actions .btn {
  height: 76rpx; line-height: 76rpx;
  font-size: 28rpx; border-radius: 12rpx; text-align: center;
  padding: 0; margin: 0; flex: 1 1 0; min-width: 0;
}
.btn::after { border: none; }
/* 左：主薄荷绿填充按钮（占 62%，主转化） */
.btn-primary {
  flex: 62 1 0;
  background: var(--brand-green); color: var(--text-on-green);
}
/* 右：描边按钮（占 34%） */
.btn-outline {
  flex: 34 1 0;
  background: #fff; color: var(--brand-green); border: 2rpx solid var(--brand-green);
}
/* 按钮 → 查看品牌故事：紧挨下方（16rpx）；底部 → 资料区块结束：40rpx */
.brand-more {
  margin-top: 16rpx; margin-bottom: 40rpx; text-align: center;
  font-size: 24rpx; color: var(--brand-green);
}

/* 资料区块结束后的浅灰色分割线（高度 8rpx，通栏） */
.divider {
  width: 100%;
  height: 8rpx;
  background: #eee;
}

/* 分割线底部 → 作品展示标题顶部：64rpx（收紧） */
.gallery { margin-top: 64rpx; padding: 0 32rpx; }
.gallery-title {
  text-align: center; font-size: 40rpx; font-weight: 600; color: #2c2c2c; letter-spacing: 4rpx;
}
.gallery-sub {
  text-align: center; margin-top: 4rpx; font-size: 20rpx; letter-spacing: 2rpx; color: #bbb; line-height: 1.2;
}

/* 分类标签：自适应居中——分类少时整体居中，超出屏幕宽度时左起横向滚动（margin:auto 在溢出时自动归零，不会裁切左侧） */
.cat-bar { margin-top: 16rpx; display: flex; }
.cat-wrap { display: inline-flex; gap: 24rpx; padding: 4rpx 4rpx 20rpx; margin: 0 auto; }
.cat-item {
  display: inline-block; font-size: 26rpx; color: #888; padding: 10rpx 6rpx;
  position: relative; transition: color .2s;
}
.cat-item.active { color: #2c2c2c; font-weight: 600; }
.cat-item.active::after {
  content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 4rpx;
  background: var(--brand-green); border-radius: 4rpx;
}

/* 作品网格：两列瀑布流（按索引奇偶分列，高度自适应，照片保持原比例不裁切） */
.masonry { display: flex; align-items: flex-start; margin: 8rpx 0 0; }
.masonry-col { flex: 1 1 0; min-width: 0; padding: 0 12rpx; display: flex; flex-direction: column; }
.grid-item {
  width: 100%; margin-bottom: 24rpx; border-radius: 20rpx;
  overflow: hidden; background: transparent;
}
/* widthFix：按图片原始比例展示，不裁切摄影画面；卡片间距 24rpx */
.grid-cover { width: 100%; display: block; }
/* 图片下方独立文字区（不叠加在照片上，无白底、跟随页面米白底色） */
.grid-cap {
  padding: 0 18rpx 18rpx;
}
.grid-title {
  display: block; text-align: left; color: #333333; font-size: 36rpx; font-weight: 500;
  margin-top: 24rpx; margin-bottom: 12rpx;
  white-space: normal; overflow: visible; text-overflow: clip; line-height: 1.4;
}
.grid-tag {
  display: block; text-align: left; color: #999999; font-size: 28rpx; font-weight: 400;
}

/* MORE / 空态 */
.more-btn {
  margin: 44rpx auto 0; width: 260rpx; height: 76rpx; line-height: 76rpx;
  text-align: center; border: 2rpx solid #ccc; color: #666; font-size: 26rpx;
  border-radius: 8rpx;
}
.more-end {
  margin-top: 44rpx; text-align: center; color: #bbb; font-size: 24rpx;
}
.empty { padding: 80rpx 0; text-align: center; color: #999; font-size: 26rpx; }

/* ===== 底部联系 ===== */
.footer {
  margin: 70rpx 32rpx 0; padding: 48rpx 40rpx 36rpx;
  background: #2c2c2c; border-radius: 24rpx; color: #fff;
}
.footer-title {
  text-align: center; font-size: 32rpx; font-weight: 600; letter-spacing: 4rpx; margin-bottom: 30rpx;
}
.footer-line {
  display: flex; align-items: center; margin-bottom: 18rpx; font-size: 26rpx;
}
.footer-label { width: 80rpx; color: #aaa; }
.footer-value { flex: 1; color: #fff; }
.footer-action {
  margin-left: 16rpx; color: var(--brand-green); font-size: 24rpx;
}
.footer-copy {
  margin-top: 30rpx; text-align: center; font-size: 22rpx; color: #777;
}

/* ===== 右侧悬浮按钮组（固定右侧不随滚动；右距 32rpx；底部预留安全距离 + 避开 iPhone 底部小黑条） ===== */
.fab-group {
  position: fixed;
  right: 32rpx;
  bottom: calc(40rpx + constant(safe-area-inset-bottom));
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 90;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}
.fab {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 文字距圆形内边缘保留安全边距：整体居中，靠内边距防止贴边 */
  padding: 0 8rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.16);
}
.fab::after { border: none; }
.fab-white { background: #fff; }
.fab-primary { background: var(--brand-green); }
.fab-ico {
  width: 40rpx;
  height: 40rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
/* 空心爱心（灰 #666666） */
.fab-ico-heart {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23666666' stroke-width='1.6' stroke-linejoin='round'><path d='M12 20.3l-1.45-1.32C5.4 14.24 2 11.16 2 7.5 2 4.42 4.42 2 7.5 2c1.74 0 3.41.81 4.5 2.09C13.09 2.81 14.76 2 16.5 2 19.58 2 22 4.42 22 7.5c0 3.66-3.4 6.74-8.55 11.49L12 20.3z'/></svg>");
}
/* 对话气泡带三点（白） */
.fab-ico-chat {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23ffffff' stroke-width='1.6' stroke-linejoin='round'><path d='M4 5h16a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H10l-4 3v-3H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z'/><circle cx='9' cy='11' r='1' fill='%23ffffff' stroke='none'/><circle cx='12' cy='11' r='1' fill='%23ffffff' stroke='none'/><circle cx='15' cy='11' r='1' fill='%23ffffff' stroke='none'/></svg>");
}
/* 用户人形轮廓（灰 #666666） */
.fab-ico-user {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23666666' stroke-width='1.6' stroke-linecap='round'><circle cx='12' cy='8' r='3.2'/><path d='M5 20a7 7 0 0 1 14 0'/></svg>");
}
.fab-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1;
}
.fab-white .fab-label { color: #666666; }
.fab-primary .fab-label { color: #ffffff; }
/* 点击轻微缩放反馈 */
.fab-hover { transform: scale(0.95); }
