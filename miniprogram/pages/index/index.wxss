.page { padding-bottom: 40rpx; }
.hero {
  padding: 90rpx 40rpx 70rpx;
  background: #111111; color: #fff; text-align: center;
}
.hero-en { font-size: 30rpx; letter-spacing: 8rpx; opacity: .85; }
.hero-cn { font-size: 64rpx; font-weight: 700; letter-spacing: 6rpx; margin-top: 16rpx; }
.hero-tag { margin-top: 20rpx; font-size: 24rpx; opacity: .6; letter-spacing: 2rpx; }

.grid { display: flex; flex-wrap: wrap; padding: 0 20rpx; }
.grid-item { width: calc(50% - 24rpx); margin: 12rpx; }
.grid-cover { width: 100%; height: 360rpx; display: block; background: #eee; }
.grid-cover--ph { background: linear-gradient(135deg,#e9e9e9,#f4f4f4); }
.grid-cap { padding: 18rpx 20rpx 22rpx; }
.grid-title { display: block; font-size: 28rpx; font-weight: 600; }
.grid-cat { display: block; margin-top: 4rpx; }

.pkg-list { padding: 0 32rpx; }
.pkg { padding: 28rpx; margin-bottom: 20rpx; }
.pkg-name { font-size: 32rpx; font-weight: 600; }
.pkg-desc { margin: 10rpx 0 16rpx; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.pkg-price { font-size: 28rpx; }

.review { margin: 0 32rpx 20rpx; padding: 28rpx; background: #fff; border-radius: 16rpx; }
.review-stars { font-size: 24rpx; color: #111; letter-spacing: 4rpx; }
.review-text { margin: 12rpx 0; font-size: 28rpx; }
.review-name { text-align: right; }

.cta-wrap { padding: 24rpx 32rpx 0; }

.detail-title { font-size: 34rpx; font-weight: 600; }
.detail-desc { margin: 10rpx 0 20rpx; }
.detail-scroll { max-height: 64vh; }
.detail-img { width: 100%; margin-bottom: 16rpx; border-radius: 8rpx; background: #f0f0f0; }
.noop {}
