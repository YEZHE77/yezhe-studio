.page { min-height: 100vh; background: #f5f6f8; padding-bottom: 90px; }
.center { padding: 80rpx 40rpx; text-align: center; }
.spinner { width: 48rpx; height: 48rpx; border: 4rpx solid #e3e6ea; border-top-color: #2f7cf6; border-radius: 50%; margin: 0 auto 20rpx; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.tip { color: #8a9099; font-size: 26rpx; }
.emoji { font-size: 64rpx; }
.title { font-size: 32rpx; font-weight: 600; color: #1f2329; margin-top: 16rpx; }
.sub { font-size: 24rpx; color: #8a9099; margin-top: 12rpx; line-height: 1.6; }
.btn-ghost { margin-top: 30rpx; background: #fff; color: #2f7cf6; border: 1rpx solid #d8dde3; border-radius: 12rpx; padding: 14rpx 40rpx; font-size: 26rpx; }
.pw { margin-top: 24rpx; width: 420rpx; background: #fff; border: 1rpx solid #d8dde3; border-radius: 12rpx; padding: 18rpx 24rpx; font-size: 28rpx; text-align: center; }
.ph { color: #b6bcc4; }
.err { color: #e5484d; font-size: 24rpx; margin-top: 12rpx; }
.btn { margin-top: 24rpx; background: #2f7cf6; color: #fff; border-radius: 12rpx; padding: 18rpx 60rpx; font-size: 28rpx; }
.hero { width: 100%; height: 460rpx; background: #e9edf2; display: block; }
.block { background: #fff; margin: 20rpx 24rpx; border-radius: 16rpx; padding: 28rpx; }
.name { font-size: 36rpx; font-weight: 700; color: #1f2329; }
.price { margin-top: 12rpx; color: #e5484d; }
.price .sym { font-size: 26rpx; }
.price .num { font-size: 44rpx; font-weight: 700; }
.price .qi { font-size: 22rpx; color: #8a9099; margin-left: 12rpx; }
.desc { margin-top: 14rpx; font-size: 26rpx; color: #5b626b; line-height: 1.7; }
.label { font-size: 26rpx; color: #8a9099; margin-bottom: 18rpx; }
.specs { display: flex; flex-wrap: wrap; gap: 16rpx; }
.spec { border: 1rpx solid #d8dde3; border-radius: 12rpx; padding: 16rpx 20rpx; min-width: 160rpx; text-align: center; background: #f7f8fa; }
.spec.on { border-color: #2f7cf6; background: #eaf2ff; }
.s-name { font-size: 26rpx; color: #1f2329; }
.s-price { font-size: 24rpx; color: #e5484d; margin-top: 6rpx; }
.kv { display: flex; justify-content: space-between; font-size: 26rpx; color: #5b626b; padding: 10rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.kv:last-child { border-bottom: none; }
.k { color: #8a9099; }
.v { color: #1f2329; }
.tag { display: inline-block; background: #fff4e6; color: #d9730d; font-size: 24rpx; padding: 10rpx 18rpx; border-radius: 10rpx; margin: 0 12rpx 12rpx 0; }
.bottom { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 24rpx; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05); }
