.page { padding: 24rpx; }
.section { margin-bottom: 12rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #111; }
.card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }

.banner { border-radius: 16rpx; padding: 20rpx 24rpx; margin-bottom: 24rpx; font-size: 26rpx; }
.banner-close { background: #f5f5f5; color: #888; }

.cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.cal-nav { width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center; border-radius: 50%; background: #f5f5f5; color: #111; font-size: 36rpx; }
.cal-month { font-size: 30rpx; font-weight: 600; color: #111; }
.cal-week { display: flex; }
.cal-wd { flex: 1; text-align: center; font-size: 24rpx; color: #999; padding: 8rpx 0; }
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell { width: 14.28%; height: 96rpx; box-sizing: border-box; padding: 6rpx; }
.cal-cell { display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 12rpx; margin-bottom: 8rpx; }
.cal-d { font-size: 28rpx; color: #222; }
.cal-dot { font-size: 18rpx; margin-top: 2rpx; padding: 0 8rpx; border-radius: 8rpx; }
.st-free { background: #fff; }
.st-free .cal-d { color: #222; }
.st-booked { background: #fde8e8; }
.st-booked .cal-d { color: #d33; }
.st-booked .cal-dot { background: #f5b5b5; color: #fff; }
.st-partial { background: #fff1f0; }
.st-partial .cal-d { color: #e0792b; }
.st-partial .cal-dot.pt { background: #ffd8a8; color: #fff; }
.st-pending { background: #fff7e0; }
.st-pending .cal-d { color: #b8870a; }
.st-pending .cal-dot.pd { background: #ffd84d; color: #6b5300; }
.st-closed { background: #f0f0f0; }
.st-closed .cal-d { color: #aaa; }
.st-closed .cal-dot.gy { background: #cfcfcf; color: #fff; }

.cal-legend { display: flex; gap: 16rpx; margin-top: 12rpx; flex-wrap: wrap; }
.lg { padding: 2rpx 10rpx; border-radius: 8rpx; }
.lg-booked { background: #fde8e8; color: #d33; }
.lg-pending { background: #fff7e0; color: #b8870a; }
.lg-closed { background: #f0f0f0; color: #999; }
.lg-free { background: #fff; color: #999; border: 1rpx solid #eee; }

.period-card .muted { margin-bottom: 16rpx; }
.period-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.period-btn { flex: 1; text-align: center; padding: 24rpx 0; border-radius: 16rpx; background: #f6f6f4; color: #222; font-size: 28rpx; position: relative; }
.period-btn.on { background: #111; color: #fff; }
.period-btn.dis { background: #f0f0f0; color: #bbb; }
.dis-tip { position: absolute; right: 8rpx; top: 6rpx; font-size: 18rpx; color: #d33; }

.tip { margin: 8rpx 4rpx 20rpx; line-height: 1.5; }
.btn-ghost { background: #fff; border: 1rpx solid #ddd; border-radius: 16rpx; text-align: center; padding: 24rpx; color: #555; font-size: 28rpx; }
.muted { color: #999; }
.small { font-size: 22rpx; }
