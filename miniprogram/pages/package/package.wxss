.page { padding: 0 0 40rpx; }
.pkg-list { padding: 0 32rpx; }
.pkg { margin-bottom: 24rpx; }
.pkg-cover { width: 100%; height: 320rpx; display: block; background: #eee; }
.pkg-cover--ph { background: linear-gradient(135deg,#e9e9e9,#f4f4f4); }
.pkg-body { padding: 24rpx 28rpx 28rpx; }
.pkg-name { font-size: 32rpx; font-weight: 600; }
.pkg-desc { margin: 10rpx 0 16rpx; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.pkg-price { font-size: 28rpx; }

.d-name { font-size: 38rpx; font-weight: 700; }
.d-price { font-size: 32rpx; margin: 8rpx 0 16rpx; }
.d-desc { font-size: 27rpx; line-height: 1.7; }
.d-block { margin-top: 28rpx; }
.d-label { font-size: 26rpx; color: #111; font-weight: 600; margin-bottom: 14rpx; }
.d-addon { display: flex; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx solid #f0f0f0; font-size: 27rpx; }
.d-tag { background: #f6f6f6; border-radius: 10rpx; padding: 14rpx 20rpx; margin-bottom: 12rpx; font-size: 26rpx; }
.d-cta { margin-top: 32rpx; }
.noop {}
