<view class="page">
  <view class="section"><view class="section-title"><text>拍摄套系</text></view></view>

  <view class="pkg-list">
    <view class="pkg card" wx:for="{{packages}}" wx:key="id" bindtap="openPkg" data-id="{{item.id}}">
      <image wx:if="{{item.cover_url}}" class="pkg-cover" src="{{item.cover_url}}" mode="aspectFill" />
      <view wx:else class="pkg-cover pkg-cover--ph"></view>
      <view class="pkg-body">
        <view class="pkg-name">{{item.name}}</view>
        <view class="pkg-desc muted small">{{item.description}}</view>
        <view class="pkg-price"><text class="price-symbol">¥</text><text class="price">{{item.price}}</text> 起</view>
      </view>
    </view>
    <view wx:if="{{packages.length === 0}}" class="empty">暂无套系</view>
  </view>
</view>
