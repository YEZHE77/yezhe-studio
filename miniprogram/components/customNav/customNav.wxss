/* 顶部导航栏 */
.nav-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #111111;
  box-sizing: border-box;
}
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.nav-left {
  display: flex;
  align-items: center;
}
/* 相机图标（白色描边，对齐歪猫公社左相机） */
.nav-camera {
  position: relative;
  width: 38rpx;
  height: 30rpx;
  margin-right: 16rpx;
  border: 3rpx solid #fff;
  border-radius: 8rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}
.nav-camera::before {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 18rpx;
  height: 12rpx;
  border: 3rpx solid #fff;
  border-bottom: none;
  border-radius: 6rpx 6rpx 0 0;
  box-sizing: border-box;
}
.nav-camera::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 13rpx;
  height: 13rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  box-sizing: border-box;
}
.nav-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}
.nav-right {
  padding: 16rpx;
  margin-right: -16rpx;
}
.hamburger {
  width: 40rpx;
  height: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.h-line {
  height: 4rpx;
  background: #fff;
  border-radius: 2rpx;
}
.nav-placeholder {
  width: 100%;
}

/* 抽屉遮罩 */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 200;
  opacity: 0;
  visibility: hidden;
  transition: opacity .3s, visibility .3s;
}
.drawer-mask.show {
  opacity: 1;
  visibility: visible;
}

/* 抽屉本体（从右侧滑出） */
.drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 560rpx;
  background: #1a1a1a;
  z-index: 201;
  transform: translateX(100%);
  transition: transform .3s ease;
  display: flex;
  flex-direction: column;
}
.drawer.open {
  transform: translateX(0);
}
.drawer-header {
  padding: 0 40rpx 40rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #333;
  box-sizing: border-box;
  min-height: 160rpx;
}
.drawer-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: #333;
}
.drawer-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
}
.drawer-body {
  flex: 1;
  height: 0;
}
.menu-item {
  color: #fff;
  font-size: 30rpx;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #2a2a2a;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.has-sub .sub-arrow {
  font-size: 22rpx;
  color: #888;
  transition: transform .2s;
}
.has-sub.open .sub-arrow {
  transform: rotate(180deg);
}
.sub-menu {
  background: #111111;
}
.sub-item {
  color: #bbb;
  font-size: 28rpx;
  padding: 24rpx 64rpx;
  border-bottom: 1rpx solid #222;
}
