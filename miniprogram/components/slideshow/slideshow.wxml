<!-- 全屏幻灯片（作品相册 / 订单相册 共用） -->
<view wx:if="{{visible}}" class="ss-mask" bindtap="onMaskTap">

  <!-- 顶部：左上角关闭× / 中间计数 / 右上角♪ BGM -->
  <view class="ss-top" catchtap="noop">
    <view class="ss-close" catchtap="close">✕</view>
    <text class="ss-count">{{index + 1}} / {{total}}</text>
    <view class="ss-bgm {{bgmOn ? 'on' : ''}}" catchtap="toggleBgm">
      <text class="ss-bgm-ico">♪</text>
    </view>
  </view>

  <!-- 素材：视频 / 图片（catchtap 阻止冒泡到蒙层；touch 处理左右滑动） -->
  <block wx:if="{{curIsVideo}}">
    <video id="ssVideo" class="ss-media ss-photo {{animClass}}" src="{{cur}}"
      autoplay="{{playing}}" loop="{{false}}" show-center-play-btn="{{false}}" controls="{{false}}"
      object-fit="contain" enable-progress-gesture="{{false}}"
      bindended="onVideoEnded" bindtimeupdate="onVideoTimeUpdate"
      catchtap="noop"
      catchtouchstart="onImgTouchStart" catchtouchend="onImgTouchEnd" />
  </block>
  <block wx:else>
    <image class="ss-media ss-photo {{animClass}}" src="{{cur}}" mode="aspectFit"
      bindload="onImgLoad" binderror="onImgError"
      catchtap="noop"
      catchtouchstart="onImgTouchStart" catchtouchend="onImgTouchEnd" />
  </block>

</view>
