.page { min-height: 100vh; background: #f7f7f5; padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom); }

/* ===== 自定义顶部栏 ===== */
.topbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: #111111;
  box-sizing: border-box;
}
.tb-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx 0 12rpx;
  box-sizing: border-box;
}
.tb-back {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 52rpx; line-height: 1;
}
.tb-title {
  flex: 1;
  text-align: center;
  color: #fff; font-size: 32rpx; font-weight: 500;
  letter-spacing: 2rpx;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
  padding: 0 12rpx;
}
.tb-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.tb-icon {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  color: #fff;
}
.tb-icon.disabled { opacity: 0.35; }
.tb-icon-symbol { font-size: 32rpx; line-height: 1; }
.tb-ph { width: 100%; }

/* ===== 骨架屏 ===== */
.sk-wrap { padding-bottom: 120rpx; }
.sk-cover { width: 100%; height: 520rpx; background: #e8e8e8; }
.sk-info { padding: 28rpx 32rpx; }
.sk-line { height: 36rpx; border-radius: 8rpx; background: #e8e8e8; }
.sk-flow { padding: 0 32rpx; }
.sk-img { width: 100%; height: 680rpx; margin-bottom: 24rpx; border-radius: 12rpx; background: #e8e8e8; }
.sk-shimmer { background: linear-gradient(90deg, #eee 25%, #f5f5f5 50%, #eee 75%); background-size: 400% 100%; animation: sk 1.2s ease-in-out infinite; }
@keyframes sk { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }

/* ===== 错误/空态 ===== */
.empty-wrap { padding: 160rpx 40rpx; text-align: center; }
.empty-icon { font-size: 64rpx; color: #999; }
.empty-text { margin-top: 24rpx; font-size: 28rpx; color: #999; text-align: center; padding: 80rpx 0; }
.retry-btn { margin-top: 32rpx; display: inline-block; padding: 16rpx 48rpx; font-size: 28rpx; color: #fff; background: #111; border-radius: 999rpx; }
.retry-btn::after { border: none; }

/* ===== 封面 + 右上悬浮分享胶囊 ===== */
.cover-wrap { position: relative; width: 100%; height: 520rpx; }
.cover-img { width: 100%; height: 100%; display: block; }
/* 分享按钮：140×72rpx 全圆角胶囊，悬浮于封面右上角，浮于图片之上不被遮挡 */
.share-capsule {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  z-index: 99;
  width: 140rpx;
  height: 72rpx;
  padding: 0;
  border-radius: 36rpx;
  background: #48c8b0;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: normal;
  line-height: 72rpx;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.18);
  transition: transform .12s ease;
}
.share-capsule::after { border: none; }
/* 按压态：轻微缩放 */
.share-capsule-hover { transform: scale(0.96); }
.share-capsule.disabled {
  background: #c9c9c9;
  color: #f0f0f0;
  box-shadow: none;
}

/* ===== 相册信息区 ===== */
.info-wrap { padding: 28rpx 32rpx 20rpx; background: #f7f7f5; }
.info-head { display: flex; align-items: center; justify-content: space-between; }
.info-title { font-size: 38rpx; font-weight: 600; color: #2c2c2c; letter-spacing: 2rpx; flex: 1; }
.view-toggle {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.view-toggle.disabled { opacity: 0.35; }
.vt-item {
  width: 48rpx; height: 48rpx;
  display: flex; align-items: center; justify-content: center;
  color: #999;
}
.vt-item.on { color: #2c2c2c; }
.vt-icon { font-size: 36rpx; line-height: 1; }
.vt-flow { font-size: 42rpx; }
.info-tag {
  display: inline-block;
  margin-top: 14rpx;
  padding: 6rpx 18rpx;
  background: #e8e8e8;
  color: #666;
  font-size: 22rpx;
  border-radius: 6rpx;
}
.info-copy {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: #555;
  white-space: pre-line;
}

/* ===== 照片内容 ===== */
.content { box-sizing: border-box; }

/* 纵向长图流式模式（默认） */
.photo-flow { padding: 8rpx 0 0; }
.flow-item { width: 100%; background: #e8e8e8; margin-bottom: 16rpx; }
.flow-item:last-child { margin-bottom: 0; }
.flow-img { width: 100%; display: block; }

/* 缩略图网格模式 */
.photo-grid { display: flex; flex-wrap: wrap; padding: 8rpx 20rpx 0; }
.photo-item {
  width: calc(33.333% - 18rpx);
  margin: 9rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #e8e8e8;
  aspect-ratio: 3 / 4;
}
.photo { width: 100%; height: 100%; display: block; }

.safe-bottom { height: 220rpx; }

/* ===== 底部品牌工具栏 ===== */
.brand-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 95;
  background: #2c2c2c;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.brand-left { display: flex; align-items: center; flex: 1; min-width: 0; }
.brand-logo {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: #fff; overflow: hidden; flex-shrink: 0;
}
.brand-text { margin-left: 16rpx; min-width: 0; }
.brand-name { font-size: 26rpx; color: #fff; font-weight: 500; }
.brand-slogan { margin-top: 4rpx; font-size: 20rpx; color: #aaa; }
.brand-tools { display: flex; align-items: center; gap: 16rpx; }
.tool {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  min-width: 72rpx; padding: 0 12rpx;
  color: #fff;
}
.tool.disabled { opacity: 0.35; }
.tool-icon { font-size: 30rpx; line-height: 1; }
.tool-label { margin-top: 4rpx; font-size: 18rpx; }
.tool-primary {
  background: #7ecdbb;
  height: 68rpx;
  border-radius: 8rpx;
  padding: 0 24rpx;
}
.tool-primary .tool-label { margin-top: 0; font-size: 24rpx; font-weight: 500; }

/* ===== 相册密码锁 ===== */
.lock-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 300;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}
.lock-card {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 56rpx 48rpx 48rpx;
  text-align: center;
  box-sizing: border-box;
}
.lock-emoji { font-size: 72rpx; }
.lock-title { margin-top: 20rpx; font-size: 34rpx; font-weight: 600; color: #222; }
.lock-sub { margin-top: 14rpx; font-size: 24rpx; color: #999; line-height: 1.6; }
.lock-pw {
  width: 100%;
  margin-top: 36rpx;
  background: #f4f4f4;
  border: 1rpx solid #e3e3e3;
  color: #111;
  text-align: center;
  padding: 24rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}
.ph { color: #aaa; }
.lock-err { color: #e05a5a; font-size: 24rpx; margin-top: 16rpx; }
.lock-btn {
  margin-top: 36rpx;
  width: 100%;
  padding: 26rpx 0;
  background: #7ecdbb;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 14rpx;
}
.lock-btn::after { border: none; }

/* ===== 分享弹窗（底部滑入） ===== */
.share-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 300;
  display: flex;
  align-items: flex-end;
}
.share-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: sheetUp .25s ease;
}
@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.share-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2c2c;
  margin-bottom: 32rpx;
}
/* 分享操作菜单：垂直列表（转发微信好友 / 生成朋友圈海报 / 下载小程序码） */
.share-menu {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 32rpx;
}
.share-menu-item {
  display: flex;
  align-items: center;
  background: #f7f7f7;
  border-radius: 14rpx;
  padding: 24rpx 28rpx;
  margin: 0;
  line-height: 1;
  transition: transform .12s ease;
}
.share-menu-item::after { border: none; }
.smi-ico {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; margin-right: 24rpx; flex-shrink: 0;
}
.smi-label { font-size: 30rpx; color: #2c2c2c; }
.share-menu-hover { transform: scale(0.97); opacity: 0.92; }
.share-cancel {
  text-align: center;
  padding: 28rpx 0;
  background: #f4f4f4;
  border-radius: 14rpx;
  font-size: 30rpx;
  color: #555;
}

/* ===== 客片海报弹窗 ===== */
.poster-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.7);
  z-index: 1000;
}
.poster-close {
  position: fixed;
  top: 32rpx; right: 32rpx;
  width: 48rpx; height: 48rpx;
  font-size: 40rpx; line-height: 48rpx; text-align: center;
  color: #fff; z-index: 1001;
}
.poster-head {
  position: fixed;
  top: 40rpx; left: 0; right: 0;
  text-align: center;
  font-size: 32rpx; color: #fff; font-weight: 500;
  z-index: 1001;
}
.poster-body {
  position: absolute;
  top: 140rpx; left: 0; right: 0;
  display: flex; flex-direction: column; align-items: center;
  padding-bottom: calc(60rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}
.poster-card {
  position: relative;
  width: 620rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
  overflow: hidden;
  min-height: 200rpx;
}
.poster-img { width: 620rpx; display: block; }
.poster-loading {
  padding: 200rpx 0; text-align: center;
  font-size: 28rpx; color: #999;
}
/* canvas 离屏绘制：移出可视区但不 display:none（保证可绘制与导出） */
.poster-canvas {
  position: fixed;
  left: -9999rpx; top: 0;
  width: 620rpx; height: 880rpx;
}
.poster-save {
  width: 620rpx;
  height: 100rpx;
  margin-top: 80rpx;
  border-radius: 50rpx;
  background: #ed5b60;
  color: #fff;
  font-size: 32rpx;
  line-height: 100rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(237,91,96,0.35);
  transition: transform .12s ease;
}
.poster-save-hover { transform: scale(0.96); }
.poster-save-disabled { opacity: 0.5; }