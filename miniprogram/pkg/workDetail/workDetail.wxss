.page { min-height: 100vh; background: #f7f7f5; }

/* ===== 自定义顶部栏 ===== */
.topbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: #111111;
  box-sizing: border-box;
}
.tb-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.tb-back {
  width: 64rpx; height: 64rpx; margin-left: -12rpx;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 52rpx; line-height: 1;
}
.tb-title {
  flex: 1;
  text-align: center;
  color: #fff; font-size: 32rpx; font-weight: 500;
  letter-spacing: 2rpx;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
  padding: 0 12rpx;
}
.tb-toggle {
  display: flex;
  background: rgba(255,255,255,0.12);
  border-radius: 999rpx;
  padding: 4rpx;
}
.seg {
  font-size: 22rpx; color: rgba(255,255,255,0.7);
  padding: 8rpx 22rpx; border-radius: 999rpx; line-height: 1.2;
}
.seg.on { background: #7ecdbb; color: #111; font-weight: 600; }
.tb-ph { width: 100%; }

/* ===== 骨架屏 ===== */
.sk-wrap { padding: 30rpx; }
.sk-grid { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.sk-img { width: 48%; height: 320rpx; margin-right: 4%; margin-bottom: 24rpx; border-radius: 12rpx; background: #e8e8e8; }
.sk-img:nth-child(2n) { margin-right: 0; }
.sk-shimmer { background: linear-gradient(90deg, #eee 25%, #f5f5f5 50%, #eee 75%); background-size: 400% 100%; animation: sk 1.2s ease-in-out infinite; }
@keyframes sk { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }

/* ===== 错误/空态 ===== */
.empty-wrap { padding: 160rpx 40rpx; text-align: center; }
.empty-icon { font-size: 64rpx; color: #999; }
.empty-text { margin-top: 24rpx; font-size: 28rpx; color: #999; text-align: center; padding: 80rpx 0; }
.retry-btn { margin-top: 32rpx; display: inline-block; padding: 16rpx 48rpx; font-size: 28rpx; color: #fff; background: #111; border-radius: 999rpx; }
.retry-btn::after { border: none; }

/* ===== 内容 ===== */
.content { min-height: 100vh; box-sizing: border-box; }

/* 自定义相册文案模块 */
.album-copy {
  margin: 24rpx 32rpx 8rpx;
  padding: 28rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #444;
  white-space: pre-line;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

/* 两列网格 */
.photo-grid { display: flex; flex-wrap: wrap; padding: 16rpx 24rpx 0; }
.photo-item {
  width: calc(50% - 12rpx);
  margin: 6rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #e8e8e8;
  aspect-ratio: 3 / 4;
}
.photo { width: 100%; height: 100%; display: block; }

/* 流式大图 */
.photo-flow { padding: 16rpx 0 0; }
.flow-item { width: 100%; background: #e8e8e8; }
.flow-img { width: 100%; display: block; }

.safe-bottom { height: 160rpx; }

/* ===== 右下角悬浮青绿色分享按钮 ===== */
.float-share {
  position: fixed;
  right: 32rpx;
  bottom: 64rpx;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 44rpx;
  border-radius: 999rpx;
  background: #7ecdbb;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.22);
}
.float-share::after { border: none; }
.float-share.disabled {
  background: #c9c9c9;
  color: #f0f0f0;
  box-shadow: none;
}

/* ===== 相册密码锁 ===== */
.lock-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 300;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}
.lock-card {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 56rpx 48rpx 48rpx;
  text-align: center;
  box-sizing: border-box;
}
.lock-emoji { font-size: 72rpx; }
.lock-title { margin-top: 20rpx; font-size: 34rpx; font-weight: 600; color: #222; }
.lock-sub { margin-top: 14rpx; font-size: 24rpx; color: #999; line-height: 1.6; }
.lock-pw {
  width: 100%;
  margin-top: 36rpx;
  background: #f4f4f4;
  border: 1rpx solid #e3e3e3;
  color: #111;
  text-align: center;
  padding: 24rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}
.ph { color: #aaa; }
.lock-err { color: #e05a5a; font-size: 24rpx; margin-top: 16rpx; }
.lock-btn {
  margin-top: 36rpx;
  width: 100%;
  padding: 26rpx 0;
  background: #7ecdbb;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 14rpx;
}
.lock-btn::after { border: none; }
