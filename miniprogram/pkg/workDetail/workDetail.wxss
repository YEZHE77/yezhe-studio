.page { min-height: 100vh; background: #f7f7f5; }

/* 骨架屏 */
.sk-wrap { padding: 30rpx; }
.sk-cover { width: 100%; height: 420rpx; border-radius: 16rpx; background: #e8e8e8; }
.sk-line { height: 32rpx; border-radius: 8rpx; background: #e8e8e8; margin-bottom: 16rpx; }
.sk-w60 { width: 60%; }
.sk-w40 { width: 40%; }
.sk-shimmer { background: linear-gradient(90deg, #eee 25%, #f5f5f5 50%, #eee 75%); background-size: 400% 100%; animation: sk 1.2s ease-in-out infinite; }
@keyframes sk { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }
.sk-grid { display: flex; flex-wrap: wrap; margin-top: 40rpx; }
.sk-img { width: 48%; height: 260rpx; margin-right: 4%; margin-bottom: 24rpx; border-radius: 12rpx; background: #e8e8e8; }
.sk-img:nth-child(2n) { margin-right: 0; }

/* 错误/空态 */
.empty-wrap { padding: 120rpx 40rpx; text-align: center; }
.empty-icon { font-size: 64rpx; color: #999; }
.empty-text { margin-top: 24rpx; font-size: 28rpx; color: #999; }
.retry-btn { margin-top: 32rpx; display: inline-block; padding: 16rpx 48rpx; font-size: 28rpx; color: #fff; background: #111; border-radius: 999rpx; }

/* 内容 */
.content { min-height: 100vh; }
.cover-wrap { position: relative; width: 100%; }
.cover { display: block; width: 100%; min-height: 300rpx; }
.cover-ph { height: 420rpx; background: #e8e8e8; }
.cover-gradient { position: absolute; left: 0; right: 0; bottom: 0; height: 200rpx; background: linear-gradient(to top, rgba(0,0,0,0.5), transparent); }
.cover-meta { position: absolute; left: 32rpx; right: 32rpx; bottom: 32rpx; color: #fff; }
.cover-title { font-size: 40rpx; font-weight: 600; line-height: 1.3; }
.cover-desc { margin-top: 12rpx; font-size: 24rpx; line-height: 1.5; opacity: 0.9; }

.section-title { padding: 48rpx 32rpx 24rpx; font-size: 32rpx; font-weight: 600; color: #111; }

/* 相册网格 */
.photo-grid { display: flex; flex-wrap: wrap; padding: 0 32rpx; }
.photo-item { width: 48%; margin-right: 4%; margin-bottom: 24rpx; border-radius: 12rpx; overflow: hidden; background: #e8e8e8; }
.photo-item:nth-child(2n) { margin-right: 0; }
.photo { display: block; width: 100%; height: 260rpx; }

.safe-bottom { height: 60rpx; }
