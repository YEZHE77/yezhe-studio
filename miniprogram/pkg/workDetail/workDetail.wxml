<view class="page">
  <!-- 自定义顶部栏：返回 + 标题 + 播放/投屏 -->
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="tb-bar" style="height: {{navHeight}}px;">
      <view class="tb-back" bindtap="goBack">‹</view>
      <view class="tb-title">{{title || '作品相册'}}</view>
      <view class="tb-actions">
        <view class="tb-icon {{canInteract ? '' : 'disabled'}}" bindtap="openSlideshow">
          <text class="tb-icon-symbol">▶</text>
        </view>
        <view class="tb-icon {{canInteract ? '' : 'disabled'}}" bindtap="cast">
          <text class="tb-icon-symbol">⍟</text>
        </view>
      </view>
    </view>
  </view>
  <view class="tb-ph" style="height: {{statusBarHeight + navHeight}}px;"></view>

  <!-- 骨架屏 -->
  <view wx:if="{{loading}}" class="sk-wrap">
    <view class="sk-cover sk-shimmer"></view>
    <view class="sk-info">
      <view class="sk-line sk-shimmer" style="width: 50%;"></view>
      <view class="sk-line sk-shimmer" style="width: 30%; margin-top: 16rpx;"></view>
    </view>
    <view class="sk-flow">
      <view wx:for="{{[1,2,3]}}" wx:key="*this" class="sk-img sk-shimmer"></view>
    </view>
  </view>

  <!-- 错误态 -->
  <view wx:elif="{{error}}" class="empty-wrap">
    <view class="empty-icon">⚠</view>
    <view class="empty-text">加载失败</view>
    <button class="retry-btn" bindtap="retry">重新加载</button>
  </view>

  <block wx:else>
    <!-- 相册内容（未锁定时展示） -->
    <block wx:if="{{!locked}}">
      <!-- 封面图 + 右上悬浮分享胶囊 -->
      <view class="cover-wrap">
        <image class="cover-img" src="{{cover}}" mode="aspectFill" lazy-load binderror="onImgError" />
        <button wx:if="{{canInteract}}" class="share-capsule" style="top: {{shareTop}}px;" bindtap="openShare">分享</button>
        <view wx:else class="share-capsule disabled" style="top: {{shareTop}}px;">分享</view>
      </view>

      <!-- 相册信息区 -->
      <view class="info-wrap">
        <view class="info-head">
          <view class="info-title">{{title || '作品相册'}}</view>
          <view class="view-toggle {{canInteract ? '' : 'disabled'}}">
            <view class="vt-item {{view==='flow' ? 'on' : ''}}" data-v="flow" bindtap="setView">
              <text class="vt-icon vt-flow">≡</text>
            </view>
            <view class="vt-item {{view==='grid' ? 'on' : ''}}" data-v="grid" bindtap="setView">
              <text class="vt-icon vt-grid">▦</text>
            </view>
          </view>
        </view>
        <view wx:if="{{category}}" class="info-tag">{{category}}</view>
        <view wx:if="{{albumCopy}}" class="info-copy">{{albumCopy}}</view>
      </view>

      <!-- 照片内容：流式/网格 -->
      <scroll-view scroll-y class="content" scroll-top="{{scrollTop}}">
        <!-- 纵向长图流式模式（默认） -->
        <view wx:if="{{view==='flow'}}" class="photo-flow">
          <view class="flow-item" wx:for="{{photos}}" wx:key="id" wx:for-index="idx" bindtap="previewImage" data-idx="{{idx}}">
            <image class="flow-img" src="{{item.preview}}" mode="widthFix" lazy-load binderror="onImgError" />
          </view>
        </view>

        <!-- 缩略图网格模式 -->
        <view wx:else class="photo-grid">
          <view class="photo-item" wx:for="{{photos}}" wx:key="id" wx:for-index="idx" bindtap="previewImage" data-idx="{{idx}}">
            <image class="photo" src="{{item.thumb}}" mode="aspectFill" lazy-load binderror="onImgError" />
          </view>
        </view>

        <view wx:if="{{!photos.length}}" class="empty-text">暂无照片</view>
        <view class="safe-bottom"></view>
      </scroll-view>

      <!-- 底部品牌工具栏 -->
      <view class="brand-bar">
        <view class="brand-left">
          <image wx:if="{{brand.logo}}" class="brand-logo" src="{{brand.logo}}" mode="aspectFill" binderror="onImgError" />
          <view class="brand-text">
            <view class="brand-name">{{brand.name || 'YEZHE WORKSHOP'}}</view>
            <view class="brand-slogan">{{brand.slogan || '记录时光中的最美瞬间'}}</view>
          </view>
        </view>
        <view class="brand-tools">
          <view class="tool {{canInteract ? '' : 'disabled'}}" bindtap="openSlideshow">
            <text class="tool-icon">▶</text>
            <text class="tool-label">播放</text>
          </view>
          <view class="tool {{canInteract ? '' : 'disabled'}}" bindtap="cast">
            <text class="tool-icon">⍟</text>
            <text class="tool-label">投屏</text>
          </view>
          <view class="tool tool-primary" bindtap="goAppointment">
            <text class="tool-label">预约服务</text>
          </view>
        </view>
      </view>
    </block>
  </block>

      <!-- 分享弹窗（底部滑入） -->
      <view wx:if="{{shareOpen}}" class="share-mask" bindtap="closeShare">
        <view class="share-sheet" catchtap="noop">
          <view class="share-title">分享相册</view>
          <view class="share-opts">
            <button class="share-opt" open-type="share">
              <view class="opt-icon" style="background:#7ecdbb;">💬</view>
              <view class="opt-label">微信好友</view>
            </button>
            <view class="share-opt" bindtap="shareTimeline">
              <view class="opt-icon" style="background:#1aad19;">🌈</view>
              <view class="opt-label">朋友圈</view>
            </view>
            <view class="share-opt" bindtap="downloadQR">
              <view class="opt-icon" style="background:#2c2c2c;">📷</view>
              <view class="opt-label">下载二维码</view>
            </view>
          </view>
          <view class="share-cancel" bindtap="closeShare">取消</view>
        </view>
      </view>

      <!-- 相册密码锁：全屏校验 -->
      <view wx:if="{{locked}}" class="lock-mask">
    <view class="lock-card">
      <view class="lock-emoji">🔒</view>
      <view class="lock-title">{{title || '受保护的相册'}}</view>
      <view class="lock-sub">该相册已设置访问密码，请输入密码查看</view>
      <input class="lock-pw" password value="{{pw}}" bindinput="onPwInput" placeholder="请输入访问密码" placeholder-class="ph" />
      <view wx:if="{{pwErr}}" class="lock-err">{{pwErr}}</view>
      <button class="lock-btn" loading="{{pwBusy}}" bindtap="verify">查看相册</button>
    </view>
  </view>

      <!-- 全屏幻灯片 -->
      <slideshow wx:if="{{showSlideshow}}" visible="{{showSlideshow}}" photos="{{photos}}" startIndex="{{slideIndex}}" bind:close="closeSlideshow" />
</view>