page { background: #f9f8f6; }
.page { padding-bottom: 60rpx; }

/* Banner 16:9 */
.banner { position: relative; width: 100%; height: 422rpx; overflow: hidden; }
.banner-img { width: 100%; height: 100%; }
.banner-mask { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,0.12), rgba(0,0,0,0.45)); }
.banner-text { position: absolute; left: 0; right: 0; bottom: 52rpx; text-align: center; color: #fff; }
.banner-en { font-size: 22rpx; letter-spacing: 8rpx; opacity: .85; }
.banner-name { margin-top: 12rpx; font-size: 48rpx; font-weight: 600; letter-spacing: 4rpx; }
.banner--ph { background: #111; color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; }

.card { background: #fff; margin: 32rpx; padding: 48rpx 40rpx; border-radius: 24rpx; box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.04); }
.card-en { font-size: 22rpx; letter-spacing: 6rpx; color: #999; text-transform: uppercase; text-align: center; }
.card-title { text-align: center; margin-top: 12rpx; font-size: 38rpx; font-weight: 600; color: #2c2c2c; letter-spacing: 4rpx; }
.story { margin-top: 28rpx; font-size: 28rpx; line-height: 1.9; color: #555; }

.contact-line { display: flex; align-items: center; margin-top: 28rpx; font-size: 28rpx; }
.c-label { width: 90rpx; color: #999; }
.c-value { flex: 1; color: #2c2c2c; }
.c-action { margin-left: 16rpx; color: #7ecdbb; font-size: 26rpx; }
.contact-empty { text-align: center; margin-top: 20rpx; font-size: 26rpx; }
.copy { margin-top: 40rpx; text-align: center; font-size: 22rpx; color: #999; }

/* 骨架屏 */
.sk { background: #fff; }
.sk-line { height: 28rpx; border-radius: 8rpx; margin-bottom: 24rpx; background: linear-gradient(90deg, #eee 25%, #f5f5f5 50%, #eee 75%); background-size: 400% 100%; animation: sk 1.2s ease-in-out infinite; }
.sk-w60 { width: 60%; }
.sk-w90 { width: 90%; }
.sk-w80 { width: 80%; }
@keyframes sk { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }
