<view class="page">
  <view class="header">
    <text class="title">上传到相册</text>
    <text class="sub">分区：{{zone}} · 待上传 {{toUploadCount}} 张<text wx:if="{{overCount}}" class="sub-over"> · 超过3M {{overCount}} 张（已过滤）</text></text>
  </view>

  <view class="toolbar">
    <button class="btn btn-choose" bindtap="onChoose" disabled="{{uploading}}">+ 选择照片</button>
    <button wx:if="{{!uploading}}" class="btn btn-confirm" bindtap="onConfirm" disabled="{{toUploadCount === 0}}">上传 {{toUploadCount}} 张</button>
    <button wx:if="{{uploading}}" class="btn btn-pause" bindtap="togglePause">{{paused ? '继续' : '暂停'}}</button>
    <button wx:if="{{uploading}}" class="btn btn-cancel" bindtap="cancelAll">取消</button>
  </view>

  <view wx:if="{{weakNet}}" class="weaknet">
    <text>⚠️ 检测到弱网，已自动重试；若持续失败请检查网络后单张重试。</text>
    <text class="weaknet__close" bindtap="onWeakClose">知道了</text>
  </view>

  <view wx:if="{{uploading}}" class="progress">
    <view class="progress__info">总进度 {{overallPct}}%</view>
    <view class="bar"><view class="bar__fill" style="width:{{overallPct}}%"></view></view>
  </view>

  <view class="grid" wx:if="{{previews.length}}">
    <view wx:for="{{previews}}" wx:key="index" class="cell {{item.oversize ? 'cell--over' : ''}} {{item.status === 'failed' ? 'cell--fail' : ''}} {{item.status === 'done' ? 'cell--done' : ''}}">
      <image src="{{item.tempFilePath}}" mode="aspectFill" class="thumb" />
      <view wx:if="{{item.oversize}}" class="mask"></view>
      <text wx:if="{{item.oversize}}" class="tag tag--over">超过3M限制</text>
      <text wx:if="{{item.oversize}}" class="tag tag--skip">已过滤</text>

      <block wx:if="{{!item.error && !item.oversize}}">
        <view wx:if="{{item.status === 'uploading'}}" class="cell__bar"><view class="cell__bar-fill" style="width:{{item.progress}}%"></view></view>
        <view wx:if="{{item.status === 'failed'}}" class="cell__retry" bindtap="retryOne" data-idx="{{index}}"><text class="tag tag--fail">↻ 重试</text></view>
        <text wx:if="{{item.status === 'done'}}" class="tag tag--ok">完成</text>
        <text wx:if="{{item.status === 'failed'}}" class="tag tag--fail">失败</text>
        <text wx:if="{{item.status === 'uploading'}}" class="tag tag--ok">上传中 {{item.progress}}%</text>
        <text wx:if="{{item.status === 'pending'}}" class="tag tag--ok">待上传</text>
      </block>

      <text wx:if="{{item.error}}" class="tag tag--warn">读取失败</text>
    </view>
  </view>

  <view wx:else class="empty">
    <text>点击「选择照片」开始上传，所有照片均可上传</text>
  </view>
</view>
