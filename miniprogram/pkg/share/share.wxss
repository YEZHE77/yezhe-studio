/* pages/share/share.wxss —— 只读分享页样式（深色） */
.page { min-height: 100vh; background: #0f0f0f; color: #f2f2f2; padding: 32rpx 28rpx 60rpx; box-sizing: border-box; }
.center { min-height: 80vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 0 40rpx; }
.spinner { width: 56rpx; height: 56rpx; border: 4rpx solid #333; border-top-color: #f2f2f2; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.tip { margin-top: 20rpx; color: #aaa; font-size: 26rpx; }
.emoji { font-size: 72rpx; margin-bottom: 20rpx; }
.title { font-size: 34rpx; font-weight: 600; }
.sub { font-size: 24rpx; color: #888; margin-top: 16rpx; line-height: 1.6; }
.btn-ghost { margin-top: 40rpx; background: transparent; color: #ccc; border: 1rpx solid #444; font-size: 26rpx; padding: 14rpx 40rpx; border-radius: 999rpx; }
.err { color: #ff6b6b; font-size: 24rpx; margin-top: 16rpx; }
.pw { width: 100%; margin-top: 30rpx; background: #1c1c1c; border: 1rpx solid #444; color: #fff; text-align: center; padding: 22rpx; border-radius: 14rpx; font-size: 30rpx; }
.ph { color: #777; }
.btn { margin-top: 30rpx; background: #f2f2f2; color: #111; font-size: 30rpx; padding: 22rpx; border-radius: 14rpx; width: 100%; }

.head { text-align: center; margin-bottom: 24rpx; }
.h1 { font-size: 38rpx; font-weight: 700; }
.h2 { font-size: 24rpx; color: #999; margin-top: 10rpx; }
.expire { font-size: 22rpx; color: #c9a36a; text-align: center; margin-bottom: 20rpx; }
.group { margin-bottom: 36rpx; }
.gtitle { font-size: 28rpx; color: #ccc; margin-bottom: 14rpx; }
.grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cell { width: calc((100% - 24rpx) / 3); position: relative; }
.img { width: 100%; height: 240rpx; border-radius: 12rpx; background: #1c1c1c; }
.zone { position: absolute; top: 8rpx; left: 8rpx; font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 8rpx; background: rgba(0,0,0,0.5); color: #fff; }
.save { position: absolute; bottom: 8rpx; right: 8rpx; font-size: 18rpx; padding: 4rpx 12rpx; border-radius: 8rpx; background: rgba(0,0,0,0.55); color: #fff; }
.empty { text-align: center; color: #888; padding: 80rpx 0; font-size: 26rpx; }
.desc { font-size: 26rpx; color: #bbb; line-height: 1.7; margin: 16rpx 0; }
.cover { width: 100%; height: 360rpx; border-radius: 16rpx; margin: 16rpx 0; background: #1c1c1c; }
.price { font-size: 40rpx; color: #f2c79a; font-weight: 700; margin-top: 8rpx; }
.line { font-size: 26rpx; color: #ccc; margin: 10rpx 0; }
.kv { display: flex; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid #222; font-size: 28rpx; }
.k { color: #888; }
.v { color: #f2f2f2; }
.summary { display: flex; justify-content: space-between; background: #1a1a1a; border-radius: 16rpx; padding: 28rpx 16rpx; margin: 20rpx 0; }
.s { display: flex; flex-direction: column; align-items: center; flex: 1; }
.s text:first-child { font-size: 22rpx; color: #888; }
.num { font-size: 30rpx; font-weight: 600; margin-top: 8rpx; }
.num.ok { color: #6bdc8a; }
.num.bad { color: #ff6b6b; }
.plist { margin-top: 16rpx; }
.prow { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #222; font-size: 28rpx; }
.pt { flex: 1; }
.pm { color: #888; font-size: 24rpx; }
.pa { font-weight: 600; }
.pa.ok { color: #6bdc8a; }
.pa.bad { color: #ff6b6b; }
.brand { text-align: center; color: #555; font-size: 22rpx; margin-top: 60rpx; }
.mt { margin-top: 40rpx; }
