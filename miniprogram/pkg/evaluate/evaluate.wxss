.page { padding: 0 0 40rpx; }
.form { margin: 0 32rpx; padding: 32rpx; }
.stars { display: flex; align-items: center; margin-bottom: 24rpx; }
.star { font-size: 56rpx; color: #dcdcdc; margin-right: 12rpx; }
.star-on { color: #111; }
.form-tip { margin-top: 20rpx; text-align: center; }

.ev { margin: 0 32rpx 20rpx; padding: 28rpx; background: #fff; border-radius: 16rpx; }
.ev-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.ev-stars { font-size: 26rpx; letter-spacing: 4rpx; }
.ev-status { font-size: 22rpx; color: #9a9a9a; background: #f0f0f0; padding: 4rpx 16rpx; border-radius: 16rpx; }
.ev-text { font-size: 28rpx; }

.ord { display: flex; justify-content: space-between; align-items: center; margin: 0 32rpx 16rpx; padding: 24rpx 28rpx; background: #fff; border-radius: 16rpx; font-size: 28rpx; }
