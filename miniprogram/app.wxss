/* app.wxss —— 黑白简约摄影风（大量留白 / 大图优先 / 黑底白字导航栏） */
page {
  background: #ffffff;
  color: #111111;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  /* ===== 全局品牌色（薄荷青绿，统一所有绿色元素，禁止杂绿） ===== */
  --brand-green: #60C4AA;        /* 主品牌薄荷绿：预约/分享按钮、标签、强调按钮背景 */
  --brand-green-light: #A8DDCF;  /* 浅绿辅助色：边框、淡背景 */
  --brand-green-dark: #4BB399;   /* hover / 按下加深色 */
  --text-on-green: #FFFFFF;      /* 绿色按钮上的白色文字 */
}
view, text, scroll-view, image { box-sizing: border-box; }

.muted { color: #9a9a9a; }
.center { text-align: center; }
.small { font-size: 24rpx; }
.line { height: 1rpx; background: #ececec; margin: 24rpx 0; }

/* 区块标题 */
.section { padding: 48rpx 32rpx 16rpx; }
.section-title {
  font-size: 40rpx; font-weight: 600; letter-spacing: 2rpx;
  display: flex; align-items: baseline; justify-content: space-between;
}
.section-sub { color: #9a9a9a; font-size: 24rpx; font-weight: 400; }

/* 卡片 */
.card {
  background: #ffffff; border-radius: 16rpx; overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
}

/* 按钮：描边黑白风 */
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  height: 88rpx; padding: 0 40rpx; border-radius: 44rpx;
  font-size: 30rpx; letter-spacing: 2rpx; background: #111111; color: #fff;
}
.btn-ghost { background: #fff; color: #111111; border: 2rpx solid #111111; }
.btn-block { width: 100%; }
.btn[disabled] { opacity: .4; }

/* 输入框 */
.field { margin-bottom: 28rpx; }
.field-label { font-size: 26rpx; color: #555; margin-bottom: 12rpx; }
.input {
  background: #fff; border: 2rpx solid #ececec; border-radius: 12rpx;
  height: 88rpx; padding: 0 24rpx; font-size: 28rpx;
}
.textarea {
  background: #fff; border: 2rpx solid #ececec; border-radius: 12rpx;
  width: 100%; padding: 20rpx 24rpx; font-size: 28rpx; min-height: 160rpx;
}

/* 标签 chip */
.chip {
  display: inline-block; padding: 10rpx 28rpx; margin-right: 16rpx; margin-bottom: 16rpx;
  border-radius: 32rpx; font-size: 24rpx; background: #fff; color: #555; border: 2rpx solid #ececec;
}
.chip-on { background: #111111; color: #fff; border-color: #111111; }

/* 价格 */
.price { color: #111; font-weight: 600; }
.price-symbol { font-size: 24rpx; }

/* 空态 */
.empty { padding: 120rpx 40rpx; text-align: center; color: #9a9a9a; }

/* 遮罩弹层 */
.mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.55);
  z-index: 100; display: flex; align-items: flex-end;
}
.sheet {
  background: #fff; width: 100%; max-height: 86vh; border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx; overflow-y: auto;
}
.sheet-bar { width: 72rpx; height: 8rpx; background: #e0e0e0; border-radius: 4rpx; margin: 0 auto 24rpx; }
