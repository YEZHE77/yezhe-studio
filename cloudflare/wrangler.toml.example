# Cloudflare Worker 配置示例
# 用法：
#   1. npm i -g wrangler （或 npx wrangler）
#   2. 复制本文件为 wrangler.toml，填入你的 bucket 名与账号 ID
#   3. wrangler login
#   4. wrangler deploy
#
# 自定义域名（正式发布微信小程序时需要备案域名）：
#   在 Cloudflare 控制台 → 你的域名 → Workers Routes → 添加路由 shturl.cc/Z/* → 选本 Worker
#   开发/体验模式也可直接用免费子域 https://<your-worker>.<sub>.workers.dev （无需买域名）

name = "yezhe-img-proxy"
main = "worker.js"
compatibility_date = "2024-09-23"

# 绑定私有 R2 桶（bucket 名 = 你在 R2 里创建的桶名）
[[r2_buckets]]
binding = "R2"
bucket_name = "yezhe-studio-img"
# 如果是自定义域路由，可加：
# route = "shturl.cc/Z/*"
