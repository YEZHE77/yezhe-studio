# 依赖
node_modules/
client/node_modules/
server/node_modules/

# 本地数据（开发用 SQLite + 上传图片），不入库
server/data/
client/dist/
uploads/

# 环境变量（含密钥），绝不提交
.env
.env.local
server/.env

# 日志
*.log
.DS_Store

# 注意：保活工作流 .github/workflows/keepalive.yml 必须入库！
# GitHub Actions 只能执行仓库中的 workflow 文件，本地文件永远不会运行。
# 曾因被此处忽略导致保活从未生效，Render 实例照常休眠、首访冷启动 30-60 秒。

# 项目记忆（WorkBuddy 内部数据，非代码）
.workbuddy/

# Vite 构建临时产物（timestamp 文件，每次 dev 都会生成，勿提交）
client/vite.config.js.timestamp-*.mjs
